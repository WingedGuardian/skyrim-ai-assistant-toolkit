{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-bash.sh\"",
            "timeout": 60,
            "statusMessage": "Checking command safety...",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/snapshot-before-tool.sh\"",
            "timeout": 60,
            "statusMessage": "Snapshotting scripts..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "timeout": 60,
            "statusMessage": "Checking file protection...",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/backup-before-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Backing up file..."
          }
        ]
      },
      {
        "matcher": "mcp__.*[Dd][Ee][Vv][-_. ]?[Bb][Ee][Nn][Cc][Hh].*|mcp__.+__[Ii]nstall[-_.]?[Pp]lugin|mcp__.+__[Ss]ort[-_.]?[Ll]oad[-_.]?[Oo]rder|mcp__.+__[Cc]lean[-_.]?[Pp]lugins|mcp__.+__[Ee]xecute[-_.]?[Cc]onsole[-_.]?[Cc]ommand|mcp__.+__[Cc]all[-_.]?[Pp]apyrus[-_.]?[Ff]unction|mcp__.*[Oo][Uu][Tt][Ff][Ii][Tt][-_. ]?[Ss][Tt][Uu][Dd][Ii][Oo].*|mcp__.*[Bb][Oo][Dd][Yy][-_. ]?[Ss][Ll][Ii][Dd][Ee].*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-mcp.sh\"",
            "timeout": 60,
            "statusMessage": "Checking game-bridge call...",
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/session-charter.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-kb-guard.sh\"",
            "timeout": 120,
            "statusMessage": "Snapshotting the knowledgebase..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/save-sentinel.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
